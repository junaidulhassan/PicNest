[Desktop Entry]
Type=Application
Name=Picnest
GenericName=Photo and Video Gallery
Comment=Browse every photo and video on your computer in one beautiful library
Exec=picnest %U
Icon=com.junaidulhassan.Picnest
Terminal=false
Categories=Graphics;Photography;Viewer;GTK;GNOME;
Keywords=Photos;Pictures;Gallery;Images;Videos;Albums;Viewer;Library;Camera;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/heic;image/heif;image/avif;image/tiff;image/bmp;image/svg+xml;video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;
StartupNotify=true
StartupWMClass=com.junaidulhassan.Picnest
DBusActivatable=false
SingleMainWindow=true
